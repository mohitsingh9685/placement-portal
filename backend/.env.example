# Local development only. Use a separate development database and test accounts.
NODE_ENV=development
PORT=9000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27028/placement_portal_dev?replicaSet=rs0

# Match the frontend Google web client ID. Generate two different random secrets.
GOOGLE_CLIENT_ID=
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Optional locally. Use rediss:// for a hosted Redis service.
REDIS_URL=

# Needed for real document and profile-image operations.
AWS_BUCKET_NAME=
AWS_BUCKET_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
